+ */
+
+#import <Foundation/Foundation.h>
+
+#import <WebDriverAgentLib/FBCommandHandler.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@interface FBPhotoImportRecord : NSObject
+@property (nonatomic, copy) NSString *requestId;
+@property (nonatomic, copy) NSString *sha256;
+@property (nonatomic, copy) NSString *path;
+@property (nonatomic, copy) NSString *status;
+@property (nonatomic, copy, nullable) NSString *assetId;
+@property (nonatomic, copy, nullable) NSString *error;
+@end
+
+@interface FBPhotoCommands : NSObject <FBCommandHandler>
+@property (class, nonatomic, readonly) NSMutableDictionary<NSString *, FBPhotoImportRecord *> *records;
++ (NSDictionary *)validatePayload:(NSDictionary *)payload;
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/WebDriverAgentLib/Commands/FBPhotoCommands.m b/WebDriverAgentLib/Commands/FBPhotoCommands.m
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/WebDriverAgentLib/Commands/FBPhotoCommands.m
@@ -0,0 +0,200 @@
+/**
+ * Copyright (c) 2026-present, iPhone Use
+ * Licensed under the Apache 2.0 license found in the project root.
+ */
+
+#import "FBPhotoCommands.h"
+
+#import <CommonCrypto/CommonDigest.h>
+#import <Photos/Photos.h>
+
+#import "FBExceptions.h"
+#import "FBResponsePayload.h"
+#import "FBRoute.h"
+#import "FBRouteRequest.h"
+
+static NSString *const FBPhotoAllowedFormat = @"^[A-Za-z0-9._:-]{8,128}$";
+static NSString *const FBPhotoTemporaryDirectory = @"iphone-use-photo-imports";
+static NSMutableDictionary<NSString *, FBPhotoImportRecord *> *FBPhotoRecords;
+
+@implementation FBPhotoImportRecord
+@end
+
+@implementation FBPhotoCommands
+
++ (void)initialize
+{
+  if (self == FBPhotoCommands.class) {
+    FBPhotoRecords = [NSMutableDictionary new];
+  }
+}
+
++ (NSArray *)routes
+{
+  return @[
+    [[FBRoute POST:@"/wda/photos/import"].withoutSession respondWithTarget:self action:@selector(handleImport:)],
+    [[FBRoute GET:@"/wda/photos/import/:requestID"].withoutSession respondWithTarget:self action:@selector(handleStatus:)],
+  ];
+}
+
++ (NSDictionary *)validatePayload:(NSDictionary *)payload
+{
+  NSString *requestId = payload[@"requestId"];
+  NSString *format = payload[@"format"];
+  NSString *expectedDigest = payload[@"sha256"];
+  NSNumber *sizeNumber = payload[@"sizeBytes"];
+  NSNumber *width = payload[@"width"];
+  NSNumber *height = payload[@"height"];
+  NSString *encoded = payload[@"data"];
+  if (![requestId isKindOfClass:NSString.class] || requestId.length < 8 || requestId.length > 128 ||
+      ![requestId canBeConvertedToEncoding:NSASCIIStringEncoding]) {
+    @throw [NSException exceptionWithName:FBInvalidArgumentException reason:@"requestId must be 8-128 ASCII characters" userInfo:nil];
+  }
+  if (!([format isKindOfClass:NSString.class] && ([format isEqualToString:@"jpeg"] || [format isEqualToString:@"png"]))) {
+    @throw [NSException exceptionWithName:FBInvalidArgumentException reason:@"format must be jpeg or png" userInfo:nil];
+  }
+  if (![expectedDigest isKindOfClass:NSString.class] || expectedDigest.length != 64 ||
+      ![expectedDigest.lowercaseString isEqualToString:expectedDigest] ||
+      ![expectedDigest isEqualToString:[self sha256Hex:encoded]]) {
+    @throw [NSException exceptionWithName:FBInvalidArgumentException reason:@"sha256 does not match decoded image bytes" userInfo:nil];
+  }
+  if (![sizeNumber isKindOfClass:NSNumber.class] || sizeNumber.unsignedIntegerValue == 0 ||
+      sizeNumber.unsignedIntegerValue > (20 * 1024 * 1024)) {
+    @throw [NSException exceptionWithName:FBInvalidArgumentException reason:@"sizeBytes is invalid or exceeds 20 MiB" userInfo:nil];
+  }
+  if (![width isKindOfClass:NSNumber.class] || ![height isKindOfClass:NSNumber.class] ||
+      width.unsignedIntegerValue == 0 || height.unsignedIntegerValue == 0 ||
+      width.unsignedIntegerValue > 100000 || height.unsignedIntegerValue > 100000) {
+    @throw [NSException exceptionWithName:FBInvalidArgumentException reason:@"image dimensions are invalid" userInfo:nil];
+  }
+  NSData *data = [[NSData alloc] initWithBase64EncodedString:encoded options:NSDataBase64DecodingIgnoreUnknownCharacters];
+  if (data.length != sizeNumber.unsignedIntegerValue) {
+    @throw [NSException exceptionWithName:FBInvalidArgumentException reason:@"base64 data length does not match sizeBytes" userInfo:nil];
+  }
+  return @{
+    @"requestId": requestId,
+    @"format": format,
+    @"sha256": expectedDigest,
+    @"sizeBytes": sizeNumber,
+    @"width": width,
+    @"height": height,
+    @"data": data,
+  };
+}
+
++ (NSString *)sha256Hex:(NSString *)encoded
+{
+  NSData *data = [[NSData alloc] initWithBase64EncodedString:encoded options:NSDataBase64DecodingIgnoreUnknownCharacters];
+  unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+  CC_SHA256(data.bytes, (CC_LONG)data.length, digest);
+  NSMutableString *result = [NSMutableString new];
+  for (NSUInteger index = 0; index < CC_SHA256_DIGEST_LENGTH; index++) {
+    [result appendFormat:@"%02x", digest[index]];
+  }
+  return result.copy;
+}
+
++ (id<FBResponsePayload>)handleImport:(FBRouteRequest *)request
+{
+  return [self importPayload:request.arguments];
+}
+
++ (id<FBResponsePayload>)handleStatus:(FBRouteRequest *)request
+{
+  return [self statusForRequestID:request.parameters[@"requestID"]];
+}
+
++ (id<FBResponsePayload>)importPayload:(NSDictionary *)payload
+{
+  NSDictionary *validated = [self validatePayload:payload];
+  NSString *requestId = validated[@"requestId"];
+  FBPhotoImportRecord *record = FBPhotoRecords[requestId];
+  if (record != nil) {
+    if (![record.sha256 isEqualToString:validated[@"sha256"]]) {
+      @throw [NSException exceptionWithName:FBInvalidArgumentException reason:@"requestId was already used for different photo bytes" userInfo:nil];
+    }
+    return FBResponseWithObject([self dictionaryFromRecord:record]);
+  }
+  record = [FBPhotoImportRecord new];
+  record.requestId = requestId;
+  record.sha256 = validated[@"sha256"];
+  record.status = @"processing";
+  FBPhotoRecords[requestId] = record;
+
+  NSString *extension = [validated[@"format"] isEqualToString:@"jpeg"] ? @"jpg" : @"png";
+  NSURL *url = [[[NSFileManager defaultManager] temporaryDirectory] URLByAppendingPathComponent:FBPhotoTemporaryDirectory isDirectory:YES];
+  url = [url URLByAppendingPathComponent:[NSString stringWithFormat:@"%@.%@", requestId, extension]];
+  NSError *error = nil;
+  if (![[NSFileManager defaultManager] createDirectoryAtURL:url.URLByDeletingLastPathComponent withIntermediateDirectories:YES attributes:nil error:&error]) {
+    record.status = @"failed"; record.error = @"Could not create temporary import directory";
+    return FBResponseWithObject([self dictionaryFromRecord:record]);
+  }
+  if (![validated[@"data"] writeToURL:url options:NSDataWritingAtomic error:&error]) {
+    record.status = @"failed"; record.error = @"Could not persist image bytes";
+    return FBResponseWithObject([self dictionaryFromRecord:record]);
+  }
+  record.path = url.path;
+
+  PHAuthorizationStatus authorization = [PHPhotoLibrary authorizationStatusForAccessLevel:PHAccessLevelAddOnly];
+  if (authorization == PHAuthorizationStatusNotDetermined) {
+    record.status = @"waiting_for_authorization";
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [PHPhotoLibrary requestAuthorizationForAccessLevel:PHAccessLevelAddOnly handler:^(PHAuthorizationStatus status) {
+        if (status != PHAuthorizationStatusAuthorized) {
+          FBPhotoRecords[requestId].status = @"failed";
+          FBPhotoRecords[requestId].error = @"Photo add permission was denied";
+          return;
+        }
+        [self saveRecord:FBPhotoRecords[requestId]];
+      }];
+    });
+    return FBResponseWithObject([self dictionaryFromRecord:record]);
+  }
+  if (authorization != PHAuthorizationStatusAuthorized) {
+    record.status = @"failed"; record.error = @"Photo add permission was denied";
+    return FBResponseWithObject([self dictionaryFromRecord:record]);
+  }
+  return [self saveRecord:record];
+}
+
++ (id<FBResponsePayload>)saveRecord:(FBPhotoImportRecord *)record
+{
+  NSError *error = nil;
+  __block NSString *assetId = nil;
+  BOOL changed = [[PHPhotoLibrary sharedPhotoLibrary] performChangesAndWait:^{
+    PHAssetCreationRequest *request = [PHAssetCreationRequest creationRequestForAsset];
+    PHAssetResourceCreationOptions *options = [PHAssetResourceCreationOptions new];
+    options.originalFilename = [NSString stringWithFormat:@"PUA-%@.%@", record.requestId, record.path.pathExtension.lowercaseString];
+    [request addResourceWithType:PHAssetResourceTypePhoto fileURL:[NSURL fileURLWithPath:record.path] options:options];
+    assetId = request.placeholderForCreatedAsset.localIdentifier;
+  } error:&error];
+  if (!changed) {
+    record.status = @"failed";
+    record.error = @"PhotoKit rejected the original-file import";
+  } else {
+    record.status = @"succeeded";
+    record.assetId = assetId;
+  }
+  return FBResponseWithObject([self dictionaryFromRecord:record]);
+}
+
++ (id<FBResponsePayload>)statusForRequestID:(NSString *)requestID
+{
+  FBPhotoImportRecord *record = FBPhotoRecords[requestID];
+  if (record == nil) {
+    @throw [NSException exceptionWithName:FBInvalidArgumentException reason:@"photo import record not found" userInfo:nil];
+  }
+  return FBResponseWithObject([self dictionaryFromRecord:record]);
+}
+
++ (NSDictionary *)dictionaryFromRecord:(FBPhotoImportRecord *)record
+{
+  return @{
+    @"requestId": record.requestId,
+    @"status": record.status,
+    @"assetId": record.assetId ?: NSNull.null,
+    @"error": record.error ?: NSNull.null,
+  };
+}
+
+@end
