+- (NSString *)storeElement:(XCUIElement *)element withKnownUUID:(NSString *)uuid
+{
+  if (nil == element || uuid.length == 0) {
+    return nil;
+  }
+  element.fb_cacheId = uuid;
+  @synchronized (self.elementCache) {
+    [self.elementCache setObject:element forKey:uuid];
+  }
+  return uuid;
+}
