++ (void)appendSnapshot:(id<FBXCElementSnapshot>)snapshot
+             viewport:(CGRect)viewport
+                nodes:(NSMutableArray *)nodes
+            snapshots:(NSMutableArray *)snapshots
+              visited:(NSUInteger *)visited
+{
+  *visited += 1;
+  FBXCElementSnapshotWrapper *wrapped = [FBXCElementSnapshotWrapper ensureWrapped:snapshot];
+  NSString *type = wrapped.wdType;
+  CGRect frame = snapshot.frame;
+  NSString *name = wrapped.wdName ?: @"";
+  NSString *label = wrapped.wdLabel ?: @"";
+  id value = wrapped.wdValue;
+  BOOL meaningful = name.length > 0 || label.length > 0 || (nil != value && ![value isEqual:@""]);
+  BOOL finite = isfinite(frame.origin.x) && isfinite(frame.origin.y) && isfinite(frame.size.width) && isfinite(frame.size.height);
+  BOOL inViewport = finite && !CGRectIsEmpty(frame) && !CGRectIsNull(CGRectIntersection(frame, viewport));
+  BOOL container = [type isEqualToString:@"XCUIElementTypeApplication"] || [type isEqualToString:@"XCUIElementTypeWindow"];
+  if (meaningful && inViewport && !container) {
+    NSMutableDictionary *node = [NSMutableDictionary dictionaryWithDictionary:@{
+      @"type": [type stringByReplacingOccurrencesOfString:@"XCUIElementType" withString:@""],
+      @"rect": @[@(frame.origin.x), @(frame.origin.y), @(frame.size.width), @(frame.size.height)],
+      @"enabled": @(wrapped.isWDEnabled),
+    }];
+    if (name.length > 0) { node[@"name"] = name; }
+    if (label.length > 0) { node[@"label"] = label; }
+    if (nil != value) { node[@"value"] = value; }
+    [nodes addObject:node];
+    [snapshots addObject:snapshot];
+  }
+  for (id<FBXCElementSnapshot> child in snapshot.children) {
+    [self appendSnapshot:child viewport:viewport nodes:nodes snapshots:snapshots visited:visited];
+  }
+}
