++ (id<FBResponsePayload>)handleGetSourceWithHandles:(FBRouteRequest *)request
+{
+  NSString *budget = request.parameters[@"max_nodes"] ?: @"200";
+  NSScanner *scanner = [NSScanner scannerWithString:budget];
+  NSInteger maximum;
+  if (![scanner scanInteger:&maximum] || !scanner.isAtEnd || maximum < 1 || maximum > 500) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"max_nodes must be between 1 and 500" traceback:nil]);
+  }
+  BOOL registerHandles = ![request.parameters[@"register_handles"] isEqualToString:@"false"];
+  XCUIApplication *application = request.session.activeApplication;
+  NSTimeInterval started = NSProcessInfo.processInfo.systemUptime;
+  NSLog(@"TREE_HANDLES snapshot begin");
+  id<FBXCElementSnapshot> root = [application fb_standardSnapshot];
+  NSTimeInterval snapshotFinished = NSProcessInfo.processInfo.systemUptime;
+  NSMutableArray *nodes = [NSMutableArray array];
+  NSMutableArray *snapshots = [NSMutableArray array];
+  NSUInteger visited = 0;
+  [self appendSnapshot:root viewport:root.frame nodes:nodes snapshots:snapshots visited:&visited];
+  NSUInteger eligible = nodes.count;
+  if (nodes.count > maximum) {
+    [nodes removeObjectsInRange:NSMakeRange(maximum, nodes.count - maximum)];
+    [snapshots removeObjectsInRange:NSMakeRange(maximum, snapshots.count - maximum)];
+  }
+  NSTimeInterval filtered = NSProcessInfo.processInfo.systemUptime;
+  // Keep registration lazy; resolving the UID query happens on live use.
+  XCUIElementQuery *query = [application descendantsMatchingType:XCUIElementTypeAny];
+  BOOL supported = [query respondsToSelector:@selector(matchingPredicate:)];
+  NSUInteger registered = 0;
+  NSUInteger registrationFailures = 0;
+  NSMutableSet *seen = [NSMutableSet set];
+  NSLog(@"TREE_HANDLES registration begin output=%lu", (unsigned long)nodes.count);
+  for (NSUInteger index = 0; index < nodes.count; index++) {
+    id<FBXCElementSnapshot> snapshot = snapshots[index];
+    NSString *uid = [FBXCElementSnapshotWrapper wdUIDWithSnapshot:snapshot];
+    NSMutableDictionary *node = nodes[index];
+    if (uid.length == 0) { continue; }
+    node[@"native_uid"] = uid;
+    if (!registerHandles || !supported) { continue; }
+    if (![seen containsObject:uid]) {
+      @try {
+        NSPredicate *predicate = [NSPredicate predicateWithFormat:@"fb_uid == %@", uid];
+        XCUIElement *element = [query matchingPredicate:predicate].element;
+        if (![element isKindOfClass:XCUIElement.class]) {
+          registrationFailures += 1;
+          continue;
+        }
+        element.lastSnapshot = snapshot;
+        [request.session.elementCache storeElement:element withKnownUUID:uid];
+        [seen addObject:uid];
+        registered += 1;
+      } @catch (NSException *exception) {
+        registrationFailures += 1;
+        continue;
+      }
+    }
+    node[@"element_id"] = uid;
+  }
+  NSTimeInterval finished = NSProcessInfo.processInfo.systemUptime;
+  NSDictionary *timings = @{
+    @"snapshot_seconds": @(snapshotFinished - started),
+    @"filter_seconds": @(filtered - snapshotFinished),
+    @"registration_seconds": @(finished - filtered),
+    @"total_seconds": @(finished - started),
+  };
+  NSLog(@"TREE_HANDLES end visited=%lu output=%lu registered=%lu timings=%@", (unsigned long)visited, (unsigned long)nodes.count, (unsigned long)registered, timings);
+  return FBResponseWithObject(@{
+    @"nodes": nodes, @"total_nodes": @(visited), @"eligible_nodes": @(eligible),
+    @"truncated": @(eligible > maximum), @"registered_handles": @(registered),
+    @"registration_failures": @(registrationFailures),
+    @"handle_api_supported": @(supported), @"binding": @"uid_predicate", @"timings": timings,
+    @"viewport": @[@(root.frame.origin.x), @(root.frame.origin.y), @(root.frame.size.width), @(root.frame.size.height)],
+  });
+}
+
 @end
